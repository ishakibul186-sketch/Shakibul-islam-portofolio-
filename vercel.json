{
  "version": 2,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/my-projects",
      "destination": "/api?route=/my-projects"
    },
    {
      "source": "/my-projects/",
      "destination": "/api?route=/my-projects"
    },
    {
      "source": "/my-projects/:id",
      "destination": "/api?route=/my-projects/:id"
    },
    {
      "source": "/projects/:id",
      "destination": "/api?route=/projects/:id"
    },
    {
      "source": "/articles/:id",
      "destination": "/api?route=/articles/:id"
    },
    {
      "source": "/skills",
      "destination": "/api?route=/skills"
    },
    {
      "source": "/skills/",
      "destination": "/api?route=/skills"
    },
    {
      "source": "/blog",
      "destination": "/api?route=/blog"
    },
    {
      "source": "/blog/",
      "destination": "/api?route=/blog"
    },
    {
      "source": "/contact",
      "destination": "/api?route=/contact"
    },
    {
      "source": "/contact/",
      "destination": "/api?route=/contact"
    },
    {
      "source": "/404",
      "destination": "/api?route=/404"
    },
    {
      "source": "/404/",
      "destination": "/api?route=/404"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/api"
    }
  ]
}
